# Copie para `.env` e preencha.
#   Copy-Item backend\.env.example backend\.env
#
# Qualquer configuração de app/infra/config.py pode ser definida aqui, com o
# nome em maiúsculas — a lista completa está no README. Depois de alterar
# este arquivo, recrie o container: docker compose up -d

# ---- Banco ----
# Referência apenas: o docker-compose cria o banco com tcc/tcc por padrão e
# NÃO lê estas variáveis deste arquivo. Para mudar, defina-as num `.env` na
# raiz do projeto, ao lado do docker-compose.yml.
POSTGRES_USER=tcc
POSTGRES_PASSWORD=tcc
POSTGRES_DB=tcc

# ---- Modo de resposta ----
# false = pipeline fixo (recuperar → reordenar → responder)
# true  = agente que escolhe ferramentas (exige OPENAI_API_KEY)
USE_AGENT=false

# Só no pipeline: false devolve os trechos do material como estão;
# true reformula a resposta com LLM (exige OPENAI_API_KEY)
USE_LLM_REFORMULATION=false

# ---- LLM ----
# Necessária apenas com USE_AGENT=true ou USE_LLM_REFORMULATION=true.
OPENAI_API_KEY=
